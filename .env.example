# Copy this file to .env and adjust values if you want credentials other than
# the local-dev defaults baked into docker-compose.yml. Never commit the real .env.

POSTGRES_DB=aeronex
POSTGRES_USER=aeronex
POSTGRES_PASSWORD=aeronex

# JWT signing secret — REQUIRED, must be at least 32 bytes for HS256. There is no
# built-in default: the app refuses to start without this set, and Docker Compose
# refuses to start the container without it too. The value below is a local-dev
# example only — copy it into your own .env and use a different value for anything
# beyond local dev.
AERONEX_JWT_SECRET=dev-only-jwt-secret-change-me-before-any-real-deployment-32bytes-minimum

# Seeded on first startup if no ADMIN user exists yet (see AdminUserBootstrapper).
# Change the password immediately in any environment beyond local dev.
AERONEX_ADMIN_USERNAME=admin
AERONEX_ADMIN_PASSWORD=admin123
