# Template only — copy to secret.yaml, replace every placeholder, and apply that
# file. NEVER commit the real secret.yaml (it is gitignored). This mirrors the
# .env.example convention used for Docker Compose: placeholders here, real
# values only ever created locally.
#
#   cp k8s/secret.yaml.example k8s/secret.yaml
#   # edit k8s/secret.yaml with real local-dev values
#   kubectl apply -f k8s/secret.yaml
#
# Equivalently, without ever writing values to a file at all:
#
#   kubectl create secret generic aeronex-secrets \
#     --from-literal=jwt-secret='<32+ byte value>' \
#     --from-literal=postgres-password='<value>' \
#     --from-literal=admin-password='<value>'
apiVersion: v1
kind: Secret
metadata:
  name: aeronex-secrets
type: Opaque
stringData:
  # Required, no default — must be at least 32 bytes for HS256. The app and this
  # manifest's own config both refuse to start without it (see JwtService).
  jwt-secret: REPLACE_ME_dev-only-jwt-secret-32bytes-minimum-change-before-use
  postgres-password: REPLACE_ME_postgres_password
  # Seeded into the bootstrapped ADMIN account on first startup if none exists yet.
  admin-password: REPLACE_ME_admin_password
